# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# private keys and local credentials
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
.npmrc
.netrc
credentials.json
service-account*.json
*-service-account.json

# local database files and backups (keep SQL migrations tracked)
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz

# local tool settings and temporary files
.claude/settings.local.json
.mcp.json
/tmp/
/temp/
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
