# Salin ke .env.local lalu isi. JANGAN commit .env.local.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server saja

# Xendit (pakai kunci MODE TEST selama development)
XENDIT_SECRET_KEY=              # server saja
XENDIT_WEBHOOK_TOKEN=           # Settings → Webhooks → verification token

# URL aplikasi (untuk isi QR meja)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password untuk akun contoh dari `npm run seed` (pilih sendiri, hanya untuk development)
SEED_PASSWORD=
